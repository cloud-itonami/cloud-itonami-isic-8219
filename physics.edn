;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": robots operate photocopying / printing /
;; finishing equipment and stage and retrieve jobs for a copy and document
;; preparation shop (ISIC 8219). The physical work declared here: loading
;; paper reams from the pallet into the production printer's high-capacity
;; feeder, and running a document through the thermal (hot-melt) binder,
;; where the glue strip must melt through before the spine is clamped.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-8219"
 :cases
 [{:id :reams-into-high-capacity-feeder
   :kind :manipulator
   :procedure "arm lifts paper reams from the pallet on the floor into the production printer's high-capacity feeder"
   :params {:l1-m 0.60 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.60 -0.40] :to [0.70 0.30] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.5 5.0 7.5 10.0 12.5]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a 10-12 kg payload class collaborative arm; one A4 80 g/m2 ream is about 2.5 kg"}
   :boundary {:lo 0.5 :hi 30.0}}
  {:id :hot-melt-binder-glue-strip
   :kind :thermal
   :procedure "thermal binder plate at 180 C heats the hot-melt glue strip in the cover spine; the glue at the paper-block face must reach 120 C before the clamp closes"
   :params {:conductivity-w-mk 0.3 :density-kg-m3 950.0 :specific-heat-j-kgk 2000.0
            :t0-c 20.0 :t-hot-c 180.0 :h-front-w-m2k 300.0 :h-back-w-m2k 0.0 :t-back-ambient-c 20.0
            :threshold-c 120.0 :duration-s 180.0 :nodes 7}
   :sweep {:param :thickness-m :values [5.0e-4 1.0e-3 1.5e-3 2.0e-3 2.5e-3]}
   :quantity :time-to-threshold-s
   :limit {:max 40.0 :basis "estimate: binder heating cycle of a desktop thermal binder; paper block treated as adiabatic at the glue's back face, EVA hot-melt properties"}
   :boundary {:lo 2.0e-4 :hi 4.0e-3}}]}
